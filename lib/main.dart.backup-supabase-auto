}

class StoreScreen extends StatefulWidget {
  const StoreScreen({super.key});

  @override
  State<StoreScreen> createState() => _StoreScreenState();
}

class _StoreScreenState extends State<StoreScreen> {
  String category = 'All';
  String query = '';
  int tab = 0;
  final Map<Product, int> cartItems = {};

  final categories = const [
    'All',
    'Kitchen',
    'Laundry',
    'Entertainment',
    'Cooling',
  ];

  void add(Product product) {
    if ((cartItems[product] ?? 0) >= product.stock) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Maximum available stock reached')),
      );
      return;
    }
    setState(() {
      cartItems[product] = (cartItems[product] ?? 0) + 1;
    });
    ScaffoldMessenger.of(context)
        .showSnackBar(SnackBar(content: Text('${product.name} added to cart')));
  }

  @override
  Widget build(BuildContext context) {
    final filtered = products.where((p) {
      final matchesCategory = category == 'All' || p.category == category;
      final matchesQuery = '${p.name} ${p.brand} ${p.category}'
          .toLowerCase()
          .contains(query.toLowerCase());
      return matchesCategory && matchesQuery;
    }).toList();

    return Scaffold(
      appBar: AppBar(
        title: const Text(
          'ApplianceHub',
          style: TextStyle(fontWeight: FontWeight.bold),
        ),
        actions: [
          IconButton(
            onPressed: () => setState(() => tab = 1),
            icon: Badge(
              isLabelVisible: cartItems.isNotEmpty,
              label: Text('${cartItems.values.fold<int>(0, (a, b) => a + b)}'),
              child: const Icon(Icons.shopping_cart_outlined),
            ),
          ),
        ],
      ),
      body: tab == 0 ? _home(filtered) : _cart(),
      bottomNavigationBar: NavigationBar(
        backgroundColor: card,
        selectedIndex: tab,
        indicatorColor: orange.withValues(alpha: 0.2),
        onDestinationSelected: (value) => setState(() => tab = value),
        destinations: const [
          NavigationDestination(
            icon: Icon(Icons.storefront_outlined),
            selectedIcon: Icon(Icons.storefront, color: orange),
            label: 'Shop',
          ),
          NavigationDestination(
            icon: Icon(Icons.shopping_bag_outlined),
            selectedIcon: Icon(Icons.shopping_bag, color: orange),
            label: 'My Cart',
          ),
        ],
      ),
    );
  }

  Widget _home(List<Product> filtered) {
    return ListView(
      padding: const EdgeInsets.all(16),
      children: [
        Container(
          padding: const EdgeInsets.all(20),
          decoration: BoxDecoration(
            gradient: const LinearGradient(
              colors: [Color(0xFF472600), Color(0xFF242424)],
            ),
            borderRadius: BorderRadius.circular(18),
          ),
          child: const Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                'UPGRADE YOUR HOME',
                style: TextStyle(color: orange, letterSpacing: 2),
              ),
              SizedBox(height: 10),
              Text(
                'Appliances for\neveryday living.',
                style: TextStyle(fontSize: 27, fontWeight: FontWeight.bold),
              ),
              SizedBox(height: 8),
              Text('Explore appliances for your home.'),
            ],
          ),
        ),
        const SizedBox(height: 20),
        TextField(
          onChanged: (value) => setState(() => query = value),
          decoration: InputDecoration(
            hintText: 'Search appliances, brands...',
            prefixIcon: const Icon(Icons.search),
            filled: true,
            fillColor: card,
            border: OutlineInputBorder(
              borderRadius: BorderRadius.circular(14),
              borderSide: BorderSide.none,
            ),
          ),
        ),
        const SizedBox(height: 18),
        const Text(
          'Categories',
          style: TextStyle(fontSize: 19, fontWeight: FontWeight.bold),
        ),
        const SizedBox(height: 10),
        SizedBox(
          height: 42,
          child: ListView.separated(
            scrollDirection: Axis.horizontal,
            itemCount: categories.length,
            separatorBuilder: (_, __) => const SizedBox(width: 8),
            itemBuilder: (context, index) {
              final c = categories[index];
              return ChoiceChip(
                label: Text(c),
                selected: category == c,
                selectedColor: orange,
                onSelected: (_) => setState(() => category = c),
              );
            },
          ),
        ),
        const SizedBox(height: 18),
        Text(
          'Popular Appliances (${filtered.length})',
          style: const TextStyle(fontSize: 19, fontWeight: FontWeight.bold),
        ),
        const SizedBox(height: 12),
        if (filtered.isEmpty)
          const Padding(
            padding: EdgeInsets.all(24),
            child: Center(child: Text('No appliances found.')),
          ),
        GridView.builder(
          shrinkWrap: true,
          physics: const NeverScrollableScrollPhysics(),
          itemCount: filtered.length,
          gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
            crossAxisCount: 2,
            mainAxisSpacing: 12,
            crossAxisSpacing: 12,
            mainAxisExtent: 260,
          ),
          itemBuilder: (context, index) {
            final p = filtered[index];
            return InkWell(
              borderRadius: BorderRadius.circular(16),
              onTap: () => Navigator.push(
                context,
                MaterialPageRoute(
                  builder: (_) =>
                      ProductDetails(product: p, onAdd: () => add(p)),
                ),
              ),
              child: Container(
                padding: const EdgeInsets.all(12),
                decoration: BoxDecoration(
                  color: card,
                  borderRadius: BorderRadius.circular(16),
                ),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Expanded(
                      child: Center(
                        child: Image.network(
                          p.imageUrl,
                          fit: BoxFit.contain,
                          errorBuilder: (_, __, ___) =>
                              Icon(p.icon, size: 68, color: orange),
                        ),
                      ),
                    ),
                    Text(
                      p.brand,
                      style: const TextStyle(color: Colors.grey, fontSize: 11),
                    ),
                    const SizedBox(height: 4),
                    Text(
                      p.name,
                      maxLines: 2,
                      overflow: TextOverflow.ellipsis,
                      style: const TextStyle(fontWeight: FontWeight.bold),
                    ),
                    const SizedBox(height: 5),
                    Text(
                      '₱${p.price.toStringAsFixed(2)}',
                      style: const TextStyle(
                        color: orange,
                        fontSize: 16,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                    Text(
                      'Stock: ${p.stock}',
                      style: const TextStyle(color: Colors.grey, fontSize: 11),
                    ),
                  ],
                ),
              ),
            );
          },
        ),
      ],
    );
  }

  Widget _cart() {
    final entries = cartItems.entries.toList();
    final total = entries.fold<double>(
      0,
      (sum, e) => sum + e.key.price * e.value,
    );

    return ListView(
      padding: const EdgeInsets.all(16),
      children: [
        const Text(
          'My Shopping Cart',
          style: TextStyle(fontSize: 24, fontWeight: FontWeight.bold),
        ),
        const SizedBox(height: 16),
        if (entries.isEmpty)
          const Padding(
            padding: EdgeInsets.all(40),
            child: Center(child: Text('Your cart is empty.')),
          ),
        ...entries.map(
          (e) => Card(
            color: card,
            child: ListTile(
              leading: Icon(e.key.icon, color: orange, size: 34),
              title: Text(e.key.name),
              subtitle: Text('₱${e.key.price.toStringAsFixed(2)} × ${e.value}'),
              trailing: Wrap(
                spacing: 0,
                children: [
                  IconButton(
                    onPressed: () => setState(() {
                      if (e.value <= 1) {
                        cartItems.remove(e.key);
                      } else {
                        cartItems[e.key] = e.value - 1;
                      }
                    }),
                    icon: const Icon(Icons.remove_circle_outline),
                  ),
                  IconButton(
                    onPressed: () => add(e.key),
                    icon: const Icon(Icons.add_circle_outline),
                  ),
                ],
              ),
            ),
          ),
        ),
        const SizedBox(height: 16),
        Text(
          'Total: ₱${total.toStringAsFixed(2)}',
          style: const TextStyle(
            fontSize: 22,
            fontWeight: FontWeight.bold,
            color: orange,
          ),
        ),
        const SizedBox(height: 16),
        FilledButton(
          style: FilledButton.styleFrom(
            backgroundColor: orange,
            foregroundColor: Colors.black,
            padding: const EdgeInsets.all(16),
          ),
          onPressed: entries.isEmpty
              ? null
              : () {
                  showDialog(
                    context: context,
                    builder: (context) => AlertDialog(
                      title: const Text('Checkout Preview'),
                      content: Text(
                        'Order total: ₱${total.toStringAsFixed(2)}\n\n'
                        'This is a local demo only. Supabase order saving and '
                        'verified payment processing have not been connected yet.',
                      ),
                      actions: [
                        TextButton(
                          onPressed: () => Navigator.pop(context),
                          child: const Text('Close'),
                        ),
                      ],
                    ),
                  );
                },
          child: const Text('PROCEED TO CHECKOUT'),
        ),
      ],
    );
  }
}

